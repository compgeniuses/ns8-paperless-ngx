import os
import json
import sys
# agent is a NethServer library which provides function to communicate with the agent
import agent # Make sure this import is present
import secrets

data = json.load(sys.stdin)

# Setup default values
random_key = secrets.token_hex(16)
PAPERLESS_SECRET_KEY = data.get("PAPERLESS_SECRET_KEY", random_key)

# --- Database Config (existing) ---
def generate_random_password():
    return secrets.token_urlsafe(16)

POSTGRES_DB = data.get("POSTGRES_DB", "paperless")
POSTGRES_USER = data.get("POSTGRES_USER", "paperless")
POSTGRES_PASSWORD = generate_random_password()

db_config = {
    "POSTGRES_DATABASE": POSTGRES_DB,
    "POSTGRES_USER": POSTGRES_USER,
    "POSTGRES_PASSWORD": POSTGRES_PASSWORD,
}
agent.write_envfile('database.env', db_config)

# --- Paperless-specific DB connection settings (existing) ---
# These tell Paperless how to connect to the DB specified above.
paperless_db_conn_config = {
    "PAPERLESS_DBENGINE": "postgresql",
    "PAPERLESS_DBHOST": "paperless-pgsql", # Service name for the PostgreSQL container
    "PAPERLESS_DBNAME": POSTGRES_DB,
    "PAPERLESS_DBUSER": POSTGRES_USER,
    "PAPERLESS_DBPASS": POSTGRES_PASSWORD,
}
agent.write_envfile('paperless-db-conn.env', paperless_db_conn_config) # Changed file name for clarity

# --- Secret Key Config (existing) ---
secret_key_config = { # Renamed dict for clarity
    "PAPERLESS_SECRET_KEY": PAPERLESS_SECRET_KEY,
}
agent.write_envfile('secret_key.env', secret_key_config)


# --- BEGIN LDAP Configuration ---
ldap_config_keys = [
    "PAPERLESS_LDAP_SERVER_URI",
    "PAPERLESS_LDAP_START_TLS", # true/false
    "PAPERLESS_LDAP_TLS_VERSION", # e.g. TLSv1.2
    "PAPERLESS_LDAP_BIND_DN",
    "PAPERLESS_LDAP_BIND_PASSWORD",
    "PAPERLESS_LDAP_USER_BASE_DN",
    "PAPERLESS_LDAP_USER_OBJECT_CLASS",
    "PAPERLESS_LDAP_USER_LOOKUP_FIELD", # default 'username'
    "PAPERLESS_LDAP_USERNAME_ATTR", # default 'uid' or 'sAMAccountName'
    "PAPERLESS_LDAP_FIRSTNAME_ATTR", # default 'givenName'
    "PAPERLESS_LDAP_LASTNAME_ATTR", # default 'sn'
    "PAPERLESS_LDAP_EMAIL_ATTR", # default 'mail'
    "PAPERLESS_LDAP_USER_UID_FORMAT", # e.g. "uid={},ou=people,dc=example,dc=com"
    "PAPERLESS_LDAP_REQUIRE_USER_GROUP", # DN of a group
    "PAPERLESS_LDAP_ADMIN_GROUP_DN", # DN of an admin group
    "PAPERLESS_LDAP_LLDAP_FIX" # true/false
]

ldap_config = {}
# Get PAPERLESS_LDAP_ENABLED specifically, default to "false" string
# Nethserver UI will pass "true" or "false" as strings for boolean-like flags
PAPERLESS_LDAP_ENABLED_INPUT = data.get("PAPERLESS_LDAP_ENABLED", "false")
ldap_enabled = PAPERLESS_LDAP_ENABLED_INPUT.lower() == "true"

ldap_config["PAPERLESS_LDAP_ENABLED"] = "true" if ldap_enabled else "false"

if ldap_enabled:
    agent.log_info("LDAP is enabled by user configuration. Setting up LDAP environment variables.")
    ldap_config["DJANGO_SETTINGS_MODULE"] = "paperless.ldap_settings"
    ldap_config["PAPERLESS_LDAP_PIP_INSTALL"] = "true" # Always true if LDAP is enabled

    # Populate other LDAP settings from data, using sensible defaults
    ldap_config["PAPERLESS_LDAP_SERVER_URI"] = data.get("PAPERLESS_LDAP_SERVER_URI", "")
    ldap_config["PAPERLESS_LDAP_START_TLS"] = data.get("PAPERLESS_LDAP_START_TLS", "false")
    ldap_config["PAPERLESS_LDAP_TLS_VERSION"] = data.get("PAPERLESS_LDAP_TLS_VERSION", "") # Let ldap_settings.py handle default protocol if empty
    ldap_config["PAPERLESS_LDAP_BIND_DN"] = data.get("PAPERLESS_LDAP_BIND_DN", "")
    ldap_config["PAPERLESS_LDAP_BIND_PASSWORD"] = data.get("PAPERLESS_LDAP_BIND_PASSWORD", "") # Handled by agent.set_secret
    ldap_config["PAPERLESS_LDAP_USER_BASE_DN"] = data.get("PAPERLESS_LDAP_USER_BASE_DN", "")
    ldap_config["PAPERLESS_LDAP_USER_OBJECT_CLASS"] = data.get("PAPERLESS_LDAP_USER_OBJECT_CLASS", "inetOrgPerson")
    ldap_config["PAPERLESS_LDAP_USER_LOOKUP_FIELD"] = data.get("PAPERLESS_LDAP_USER_LOOKUP_FIELD", "username")
    ldap_config["PAPERLESS_LDAP_USERNAME_ATTR"] = data.get("PAPERLESS_LDAP_USERNAME_ATTR", "uid")
    ldap_config["PAPERLESS_LDAP_FIRSTNAME_ATTR"] = data.get("PAPERLESS_LDAP_FIRSTNAME_ATTR", "givenName")
    ldap_config["PAPERLESS_LDAP_LASTNAME_ATTR"] = data.get("PAPERLESS_LDAP_LASTNAME_ATTR", "sn")
    ldap_config["PAPERLESS_LDAP_EMAIL_ATTR"] = data.get("PAPERLESS_LDAP_EMAIL_ATTR", "mail")
    ldap_config["PAPERLESS_LDAP_USER_UID_FORMAT"] = data.get("PAPERLESS_LDAP_USER_UID_FORMAT", "")
    ldap_config["PAPERLESS_LDAP_REQUIRE_USER_GROUP"] = data.get("PAPERLESS_LDAP_REQUIRE_USER_GROUP", "")
    ldap_config["PAPERLESS_LDAP_ADMIN_GROUP_DN"] = data.get("PAPERLESS_LDAP_ADMIN_GROUP_DN", "")
    ldap_config["PAPERLESS_LDAP_LLDAP_FIX"] = data.get("PAPERLESS_LDAP_LLDAP_FIX", "false")

    # Handle sensitive password fields using agent.set_secret if available,
    # otherwise, they are just written to the env file (less ideal).
    # For now, write_envfile will handle it. NethServer admins should be aware of .env file sensitivity.
    if data.get("PAPERLESS_LDAP_BIND_PASSWORD"):
         agent.set_secret("PAPERLESS_LDAP_BIND_PASSWORD_SECRET", data.get("PAPERLESS_LDAP_BIND_PASSWORD"))
         # ldap_settings.py would then need to be adapted to try reading _SECRET suffixed variable if the main one is empty.
         # For simplicity now, directly writing to env file.
else:
    agent.log_info("LDAP is not enabled by user configuration.")
    # Ensure DJANGO_SETTINGS_MODULE is not set or defaults to standard paperless.settings
    # If paperless-ngx.env might already exist, we might need to unset it.
    # However, configure scripts usually define the full state.
    ldap_config["DJANGO_SETTINGS_MODULE"] = "" # Explicitly empty to ensure default Django behavior
    ldap_config["PAPERLESS_LDAP_PIP_INSTALL"] = "false"


# Write the combined Paperless NGX app specific settings (including LDAP)
# This assumes a file named 'paperless-ngx.env' is appropriate for these.
# The original script didn't explicitly write such a file, relying on dump_env.
# Let's consolidate Paperless specific settings here.
paperless_app_config = {**ldap_config} # Start with LDAP, add others if any

# Example: if other app-specific (non-DB, non-secret) vars were needed:
# paperless_app_config["PAPERLESS_TIME_ZONE"] = data.get("PAPERLESS_TIME_ZONE", "UTC")
# For now, only LDAP related vars are managed here beyond DB and SECRET.

agent.write_envfile('paperless-app.env', paperless_app_config)
# --- END LDAP Configuration ---


# Make sure everything is saved inside the environment file
# just before starting systemd unit
agent.dump_env()
agent.log_info("Environment data dumped for systemd service.")
