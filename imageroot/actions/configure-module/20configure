import os
import json
import sys
# agent is a NethServer library which provides function to communicate with the agent
import agent
data = json.load(sys.stdin)
agent.set_progress(10)
os.umask(0o077)
existing = agent.read_envfile('paperless-ngx.env') if os.path.exists('paperless-ngx.env') else {}
def setting(key, default):
    return data.get(key, existing.get(key, default))
# Setup default values
paperless_name = data.get("paperless_name", existing.get("PAPERLESS_NGX_NAME", "paperless-ngx"))
PAPERLESS_ADMIN_USER = setting("PAPERLESS_ADMIN_USER","paperlessadmin")
PAPERLESS_ADMIN_PASSWORD = data.get("PAPERLESS_ADMIN_PASSWORD") or existing.get("PAPERLESS_ADMIN_PASSWORD")
if not PAPERLESS_ADMIN_PASSWORD:
    import secrets
    PAPERLESS_ADMIN_PASSWORD = secrets.token_urlsafe(32)
PAPERLESS_ADMIN_MAIL = setting("PAPERLESS_ADMIN_MAIL","")
PAPERLESS_TIME_ZONE = setting("PAPERLESS_TIME_ZONE","America/Los_Angeles")
PAPERLESS_OCR_LANGUAGE = setting("PAPERLESS_OCR_LANGUAGE","eng")
PAPERLESS_COOKIE_PREFIX = setting("PAPERLESS_COOKIE_PREFIX","paperlessngx")
PAPERLESS_FILENAME_FORMAT = setting("PAPERLESS_FILENAME_FORMAT","{created_year}/{correspondent}/{doc_pk}-{title}")
# PAperless CSRF settings
host = data.get("host", "")
PAPERLESS_URL = "https://"+host

paperless_config = {
    "PAPERLESS_NGX_NAME": paperless_name,
    "PAPERLESS_TIME_ZONE": PAPERLESS_TIME_ZONE,
    "PAPERLESS_OCR_LANGUAGE": PAPERLESS_OCR_LANGUAGE,
    "PAPERLESS_COOKIE_PREFIX": PAPERLESS_COOKIE_PREFIX,
    "PAPERLESS_ADMIN_USER": PAPERLESS_ADMIN_USER,
    "PAPERLESS_ADMIN_PASSWORD": PAPERLESS_ADMIN_PASSWORD,
    "PAPERLESS_ADMIN_MAIL": PAPERLESS_ADMIN_MAIL,
    "PAPERLESS_FILENAME_FORMAT": PAPERLESS_FILENAME_FORMAT,
    "PAPERLESS_URL": PAPERLESS_URL,
    "PAPERLESS_TIKA_ENABLED": "1",
    "PAPERLESS_TIKA_GOTENBERG_ENDPOINT": "http://127.0.0.1:3000",
    "PAPERLESS_TIKA_ENDPOINT": "http://127.0.0.1:9998",

}

agent.write_envfile('paperless-ngx.env', {**existing, **paperless_config})
os.chmod('paperless-ngx.env', 0o600)


# Make sure everything is saved inside the environment file
# just before starting systemd unit
agent.unset_env("PAPERLESS_ADMIN_PASSWORD")
agent.dump_env()
