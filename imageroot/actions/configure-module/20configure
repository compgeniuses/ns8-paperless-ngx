import os
import json
import sys
import agent 
import secrets

data = json.load(sys.stdin)

# --- Database Server Config (for PostgreSQL service itself) ---
def generate_random_password():
    return secrets.token_urlsafe(16)

POSTGRES_DB = data.get("POSTGRES_DB", "paperless")
POSTGRES_USER = data.get("POSTGRES_USER", "paperless")
POSTGRES_PASSWORD = data.get("POSTGRES_PASSWORD", generate_random_password())

db_server_config = {
    "POSTGRES_DATABASE": POSTGRES_DB,
    "POSTGRES_USER": POSTGRES_USER,
    "POSTGRES_PASSWORD": POSTGRES_PASSWORD,
}
agent.write_envfile('database.env', db_server_config)

# --- Paperless NGX's Connection Settings to its Database ---
paperless_db_conn_config = {
    "PAPERLESS_DBENGINE": "postgresql",
    "PAPERLESS_DBHOST": data.get("PAPERLESS_DBHOST", "paperless-pgsql"),
    "PAPERLESS_DBNAME": POSTGRES_DB,
    "PAPERLESS_DBUSER": POSTGRES_USER,
    "PAPERLESS_DBPASS": POSTGRES_PASSWORD,
}
# Corrected filename:
agent.write_envfile('paperless-db.env', paperless_db_conn_config)

# --- Paperless NGX Secret Key ---
PAPERLESS_SECRET_KEY = data.get("PAPERLESS_SECRET_KEY", secrets.token_hex(32))
secret_key_config = {
    "PAPERLESS_SECRET_KEY": PAPERLESS_SECRET_KEY,
}
agent.write_envfile('secret_key.env', secret_key_config)


# --- BEGINNING OF STANDARD PAPERLESS NGX APPLICATION SETTINGS ---
paperless_app_env_config = {}

paperless_app_env_config["PAPERLESS_NGX_NAME"] = data.get("paperless_name", "paperless-ngx")
paperless_app_env_config["PAPERLESS_ADMIN_USER"] = data.get("PAPERLESS_ADMIN_USER", "paperlessadmin")
paperless_app_env_config["PAPERLESS_ADMIN_PASSWORD"] = data.get("PAPERLESS_ADMIN_PASSWORD", "P@perle5$")
paperless_app_env_config["PAPERLESS_ADMIN_MAIL"] = data.get("PAPERLESS_ADMIN_MAIL", "")
paperless_app_env_config["PAPERLESS_TIME_ZONE"] = data.get("PAPERLESS_TIME_ZONE", "America/Los_Angeles")
paperless_app_env_config["PAPERLESS_OCR_LANGUAGE"] = data.get("PAPERLESS_OCR_LANGUAGE", "eng")
paperless_app_env_config["PAPERLESS_COOKIE_PREFIX"] = data.get("PAPERLESS_COOKIE_PREFIX", "paperlessngx")
paperless_app_env_config["PAPERLESS_FILENAME_FORMAT"] = data.get("PAPERLESS_FILENAME_FORMAT", "{created_year}/{correspondent}/{doc_pk}-{title}")

# Email Settings
smtp_settings = data.get("smtp_settings", {
    "host": "", "port": "587", "username": "", "password": "", "tls_verify": "true"
})

paperless_app_env_config["PAPERLESS_EMAIL_HOST"] = smtp_settings.get('host', "")
paperless_app_env_config["PAPERLESS_EMAIL_PORT"] = str(smtp_settings.get('port', "587"))
paperless_app_env_config["PAPERLESS_EMAIL_HOST_USER"] = smtp_settings.get('username', "")
paperless_app_env_config["PAPERLESS_EMAIL_FROM"] = smtp_settings.get('username', "")
paperless_app_env_config["PAPERLESS_EMAIL_HOST_PASSWORD"] = smtp_settings.get('password', "")

email_use_tls_str = smtp_settings.get('tls_verify', "true")
if isinstance(email_use_tls_str, bool):
    email_use_tls_str = "true" if email_use_tls_str else "false"
elif isinstance(email_use_tls_str, str):
    email_use_tls_str = email_use_tls_str.lower()

paperless_app_env_config["PAPERLESS_EMAIL_USE_TLS"] = "true" if email_use_tls_str == "true" else "false"
paperless_app_env_config["PAPERLESS_EMAIL_USE_SSL"] = "false" if email_use_tls_str == "true" else "true"

# Paperless URL and CSRF settings
host = data.get("host", "")
if host:
    paperless_app_env_config["PAPERLESS_URL"] = "https://" + host
    paperless_app_env_config["PAPERLESS_CSRF_TRUSTED_ORIGINS"] = "https://" + host 
else:
    paperless_app_env_config["PAPERLESS_URL"] = ""
    paperless_app_env_config["PAPERLESS_CSRF_TRUSTED_ORIGINS"] = ""

# Default Tika settings
paperless_app_env_config["PAPERLESS_TIKA_ENABLED"] = "true"
paperless_app_env_config["PAPERLESS_TIKA_GOTENBERG_ENDPOINT"] = "http://paperless-gotenberg:3000"
paperless_app_env_config["PAPERLESS_TIKA_ENDPOINT"] = "http://paperless-tika:9998"
# --- END OF STANDARD PAPERLESS NGX APPLICATION SETTINGS ---


# --- LDAP Configuration (conditionally added) ---
ldap_specific_config = {}
PAPERLESS_LDAP_ENABLED_INPUT = data.get("PAPERLESS_LDAP_ENABLED", "false")
ldap_enabled = PAPERLESS_LDAP_ENABLED_INPUT.lower() == "true"

ldap_specific_config["PAPERLESS_LDAP_ENABLED"] = "true" if ldap_enabled else "false"

if ldap_enabled:
    agent.log_info("LDAP is enabled. Configuring LDAP environment variables.")
    ldap_specific_config["DJANGO_SETTINGS_MODULE"] = "paperless.ldap_settings"
    ldap_specific_config["PAPERLESS_LDAP_PIP_INSTALL"] = "true"

    ldap_specific_config["PAPERLESS_LDAP_SERVER_URI"] = data.get("PAPERLESS_LDAP_SERVER_URI", "")
    ldap_specific_config["PAPERLESS_LDAP_START_TLS"] = data.get("PAPERLESS_LDAP_START_TLS", "false")
    ldap_specific_config["PAPERLESS_LDAP_TLS_VERSION"] = data.get("PAPERLESS_LDAP_TLS_VERSION", "")
    ldap_specific_config["PAPERLESS_LDAP_BIND_DN"] = data.get("PAPERLESS_LDAP_BIND_DN", "")
    ldap_specific_config["PAPERLESS_LDAP_BIND_PASSWORD"] = data.get("PAPERLESS_LDAP_BIND_PASSWORD", "")
    ldap_specific_config["PAPERLESS_LDAP_USER_BASE_DN"] = data.get("PAPERLESS_LDAP_USER_BASE_DN", "")
    ldap_specific_config["PAPERLESS_LDAP_USER_OBJECT_CLASS"] = data.get("PAPERLESS_LDAP_USER_OBJECT_CLASS", "inetOrgPerson")
    ldap_specific_config["PAPERLESS_LDAP_USER_LOOKUP_FIELD"] = data.get("PAPERLESS_LDAP_USER_LOOKUP_FIELD", "username")
    ldap_specific_config["PAPERLESS_LDAP_USERNAME_ATTR"] = data.get("PAPERLESS_LDAP_USERNAME_ATTR", "uid")
    ldap_specific_config["PAPERLESS_LDAP_FIRSTNAME_ATTR"] = data.get("PAPERLESS_LDAP_FIRSTNAME_ATTR", "givenName")
    ldap_specific_config["PAPERLESS_LDAP_LASTNAME_ATTR"] = data.get("PAPERLESS_LDAP_LASTNAME_ATTR", "sn")
    ldap_specific_config["PAPERLESS_LDAP_EMAIL_ATTR"] = data.get("PAPERLESS_LDAP_EMAIL_ATTR", "mail")
    ldap_specific_config["PAPERLESS_LDAP_USER_UID_FORMAT"] = data.get("PAPERLESS_LDAP_USER_UID_FORMAT", "")
    ldap_specific_config["PAPERLESS_LDAP_REQUIRE_USER_GROUP"] = data.get("PAPERLESS_LDAP_REQUIRE_USER_GROUP", "")
    ldap_specific_config["PAPERLESS_LDAP_ADMIN_GROUP_DN"] = data.get("PAPERLESS_LDAP_ADMIN_GROUP_DN", "")
    ldap_specific_config["PAPERLESS_LDAP_LLDAP_FIX"] = data.get("PAPERLESS_LDAP_LLDAP_FIX", "false")
else:
    agent.log_info("LDAP is not enabled.")
    ldap_specific_config["DJANGO_SETTINGS_MODULE"] = "" 
    ldap_specific_config["PAPERLESS_LDAP_PIP_INSTALL"] = "false"

# Merge standard app settings with LDAP specific settings.
paperless_app_env_config.update(ldap_specific_config)

# Corrected filename:
agent.write_envfile('paperless-ngx.env', paperless_app_env_config)
# --- END OF LDAP Configuration ---

# Finalize environment for the service
agent.dump_env()
agent.log_info("Environment data dumped for systemd service.")
