{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "configure-module",
  "$id": "https://schema.nethserver.org/paperlessngx/configure-module-validate-input.json",
  "description": "Configure paperless",
  "type": "object",
  "properties": {
    "paperless_name": {
      "type": "string",
      "pattern": "^[^\\r\\n]*$"
    },
    "PAPERLESS_ADMIN_USER": {
      "type": "string",
      "pattern": "^[^\\r\\n]*$"
    },
    "PAPERLESS_ADMIN_PASSWORD": {
      "type": "string",
      "pattern": "^[^\\r\\n]*$"
    },
    "PAPERLESS_ADMIN_MAIL": {
      "type": "string",
      "pattern": "^[^\\r\\n]*$"
    },
    "PAPERLESS_TIME_ZONE": {
      "type": "string",
      "pattern": "^[^\\r\\n]*$"
    },
    "PAPERLESS_OCR_LANGUAGE": {
      "type": "string",
      "pattern": "^[^\\r\\n]*$"
    },
    "PAPERLESS_COOKIE_PREFIX": {
      "type": "string",
      "pattern": "^[^\\r\\n]*$"
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]*$"
    },
    "PAPERLESS_URL": {
      "type": "string",
      "description": "Deprecated compatibility field; ignored by configure-module.",
      "deprecated": true,
      "pattern": "^[^\\r\\n]*$"
    },
    "POSTGRES_DB": {
      "type": "string",
      "description": "Deprecated compatibility field; ignored by configure-module.",
      "deprecated": true,
      "pattern": "^[^\\r\\n]*$"
    },
    "POSTGRES_USER": {
      "type": "string",
      "description": "Deprecated compatibility field; ignored by configure-module.",
      "deprecated": true,
      "pattern": "^[^\\r\\n]*$"
    },
    "POSTGRES_PASSWORD": {
      "type": "string",
      "description": "Deprecated compatibility field; ignored by configure-module.",
      "deprecated": true,
      "pattern": "^[^\\r\\n]*$"
    },
    "PAPERLESS_TIKA_ENABLED": {
      "type": "boolean",
      "description": "Deprecated compatibility field; ignored by configure-module.",
      "deprecated": true
    },
    "PHP_ENABLE_OPCACHE": {
      "type": "boolean",
      "description": "Deprecated compatibility field; ignored by configure-module.",
      "deprecated": true
    },
    "PHP_MEMORY_LIMIT": {
      "type": "string",
      "description": "Deprecated compatibility field; ignored by configure-module.",
      "deprecated": true,
      "pattern": "^[^\\r\\n]*$"
    },
    "PAPERLESS_FILENAME_FORMAT": {
      "type": "string",
      "pattern": "^[^\\r\\n]*$"
    },
    "http2https": {
      "type": "boolean"
    },
    "lets_encrypt": {
      "type": "boolean"
    }
  },
  "required": [
    "host"
  ]
}
