#!/usr/bin/env python3
"""Read configuration without exposing stored passwords to the reader role."""
import json
import os
import sys
import agent

values = agent.read_envfile('paperless-ngx.env') if os.path.exists('paperless-ngx.env') else {}
keys = ['PAPERLESS_TIME_ZONE', 'PAPERLESS_OCR_LANGUAGE', 'PAPERLESS_ADMIN_USER',
        'PAPERLESS_ADMIN_MAIL', 'PAPERLESS_COOKIE_PREFIX', 'PAPERLESS_FILENAME_FORMAT']
config = {key: values.get(key, os.getenv(key, '')) for key in keys}
config.update(host=os.getenv('TRAEFIK_HOST', ''),
              http2https=os.getenv('TRAEFIK_HTTP2HTTPS', '').lower() == 'true',
              lets_encrypt=os.getenv('TRAEFIK_LETS_ENCRYPT', '').lower() == 'true',
              paperless_name=values.get('PAPERLESS_NGX_NAME', os.getenv('PAPERLESS_NGX_NAME', '')),
              PAPERLESS_ADMIN_PASSWORD='')
json.dump(config, sys.stdout)
