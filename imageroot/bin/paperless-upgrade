#!/usr/bin/env python3
"""Guard migrations before restart and before the container entrypoint runs."""
import fcntl
import http.client
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time
from urllib.parse import urlsplit

import agent
from paperless_v3 import DB_OPTIONS, check_cpu, migrate_options, review_fingerprint, review_requirements, verify_review

MODULE_STAGE = '2.0'
APP_VERSION = '3.4.2'
MINIMUM_MODULE = (1, 4, 0)
STATE = Path(os.environ.get('AGENT_STATE_DIR', '.'))


def module_version(reference):
    match = re.fullmatch(r'.+:(\d+)\.(\d+)\.(\d+)', reference or '')
    return tuple(map(int, match.groups())) if match else None


def read_json(name):
    path = STATE / 'upgrades' / name
    return json.loads(path.read_text()) if path.exists() else {}


def write_json(name, value):
    path = STATE / 'upgrades' / name
    path.parent.mkdir(mode=0o700, exist_ok=True)
    temporary = path.with_name(path.name + f'.{os.getpid()}.tmp')
    with temporary.open('w') as stream:
        json.dump(value, stream, sort_keys=True)
        stream.write('\n')
        stream.flush()
        os.fsync(stream.fileno())
    temporary.chmod(0o600)
    temporary.replace(path)


def run(*command, timeout=300):
    result = subprocess.run(command, text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, timeout=timeout)
    if result.returncode:
        # Environment files and subprocess arguments can contain secrets.
        raise RuntimeError(f'{command[0]} failed during the upgrade safety check')
    return result.stdout.strip()


def sql(statement):
    db = agent.read_envfile(str(STATE / 'database.env'))
    return run('podman', 'exec', 'paperless-pgsql', 'psql', '-XAt',
               '-U', db['POSTGRES_USER'], '-d', db['POSTGRES_DATABASE'],
               '-v', 'ON_ERROR_STOP=1', '-c', statement)


def wait_database():
    deadline = time.monotonic() + 120
    while True:
        try:
            if sql('SELECT 1') == '1':
                return
        except (RuntimeError, subprocess.TimeoutExpired):
            pass
        if time.monotonic() >= deadline:
            raise RuntimeError('PostgreSQL is not ready; no application migration was started')
        time.sleep(2)


def valid_source(reference):
    version = module_version(reference)
    return (bool(reference) and reference.rsplit(':', 1)[0] == 'ghcr.io/compgeniuses/paperlessngx'
            and version is not None and ((version[0] == 1 and version >= MINIMUM_MODULE) or version[0] == 2))


def migration_fingerprint():
    return sql("SELECT md5(string_agg(app || '.' || name, ',' ORDER BY app, name)) FROM django_migrations")


def file_hash(path):
    digest = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            digest.update(block)
    return digest.hexdigest()


def atomic_copy(source, target):
    temporary = target.with_name(target.name + f'.{os.getpid()}.tmp')
    try:
        shutil.copy2(source, temporary)
        temporary.chmod(0o600)
        with temporary.open('rb') as stream:
            os.fsync(stream.fileno())
        temporary.replace(target)
    finally:
        if temporary.exists():
            temporary.unlink()



def options_for_review():
    options = agent.read_envfile(str(STATE / 'paperless-ngx.env'))
    db = agent.read_envfile(str(STATE / 'paperless-db.env'))
    for key in DB_OPTIONS:
        if key in db and key not in options:
            options[key] = db[key]
    return options


def saved_queries():
    related = sql("SELECT (SELECT count(*) FROM documents_note) + (SELECT count(*) FROM documents_customfieldinstance)")
    if related == '0':
        return []
    return json.loads(sql("SELECT COALESCE(json_agg(value ORDER BY id), '[]'::json)::text FROM documents_savedviewfilterrule WHERE rule_type=20 AND value IS NOT NULL"))


def validate_v3_source(options=None):
    check_cpu()
    if sql("SELECT count(*) FROM documents_document WHERE storage_type='gpg'") != '0':
        raise RuntimeError('Upgrade blocked: decrypt all encrypted documents on Paperless 2.20.15 before moving to v3')
    if int(sql('SELECT COALESCE(max(maximum_age), 0) FROM paperless_mail_mailrule')) > 32767:
        raise RuntimeError('Upgrade blocked: review mail rules with maximum_age greater than 32767 before v3')
    options = options_for_review() if options is None else options
    if options.get('PAPERLESS_PASSPHRASE'):
        raise RuntimeError('Upgrade blocked: remove the legacy passphrase setting after verifying document decryption')
    queries = saved_queries()
    fingerprint = verify_review(options, queries, read_json('paperless-v3-review.json'))
    migrate_options(options)  # Validate conversions before any file is replaced.
    return fingerprint


def allowed_source_checkpoint(checkpoint):
    if checkpoint.get('healthy') is not True:
        return False
    if checkpoint.get('module_stage') == '1.4' and checkpoint.get('application_version') == '2.20.15':
        return True
    try:
        previous = tuple(int(value) for value in checkpoint.get('application_version', '').split('.'))
        target = tuple(int(value) for value in APP_VERSION.split('.'))
        return str(checkpoint.get('module_stage', '')).startswith('2.') and len(previous) == 3 and previous[0] == 3 and previous <= target
    except ValueError:
        return False


def source_checkpoint():
    checkpoint = read_json('paperless-checkpoint.json')
    if (not allowed_source_checkpoint(checkpoint)
            or not (valid_source(checkpoint.get('module_image')) or valid_source(os.environ.get('PREV_IMAGE_URL')))):
        raise RuntimeError('Upgrade blocked: install stable module 1.4.0 first and verify the Paperless 2.20.15 checkpoint')
    wait_database()
    if checkpoint.get('migration_fingerprint') != migration_fingerprint():
        raise RuntimeError('Upgrade blocked: the database does not match its healthy source checkpoint')
    return checkpoint


def configuration_fingerprint():
    values = {name: agent.read_envfile(str(STATE / name)) for name in ['paperless-ngx.env', 'paperless-db.env']}
    return hashlib.sha256(json.dumps(values, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def preflight(prepare=False):
    check_cpu()
    checkpoint = read_json('paperless-checkpoint.json')
    if (checkpoint.get('module_stage') == MODULE_STAGE
            and checkpoint.get('application_version') == APP_VERSION
            and checkpoint.get('healthy') is True):
        wait_database()
        if checkpoint.get('migration_fingerprint') != migration_fingerprint():
            raise RuntimeError('Upgrade blocked: the database no longer matches its recorded checkpoint')
        return 'checkpoint'
    transition = read_json('paperless-transition.json')
    if transition.get('target_application') == APP_VERSION and transition.get('backup_complete') is True:
        source = transition.get('source_checkpoint', {})
        if not allowed_source_checkpoint(source):
            raise RuntimeError('Upgrade blocked: the v3 transition has no verified 2.20.15 source')
        backup = STATE / 'upgrades/2.0.0/paperless.pg_dump'
        if not backup.is_file() or file_hash(backup) != transition.get('backup_sha256'):
            raise RuntimeError('Upgrade blocked: the original database backup is missing or changed')
        if configuration_fingerprint() != transition.get('target_configuration_fingerprint'):
            raise RuntimeError('Upgrade blocked: configuration changed after v3 preparation; review before retrying')
        wait_database()
        if source.get('application_version') == '2.20.15' and migration_fingerprint() == source.get('migration_fingerprint'):
            old_options = agent.read_envfile(str(STATE / 'upgrades/2.0.0/paperless-ngx.env'))
            old_db = agent.read_envfile(str(STATE / 'upgrades/2.0.0/paperless-db.env'))
            for key in DB_OPTIONS:
                if key in old_db and key not in old_options:
                    old_options[key] = old_db[key]
            validate_v3_source(old_options)
        return 'transition'
    fresh = read_json('paperless-fresh.json')
    if fresh.get('application_version') == APP_VERSION:
        wait_database()
        if fresh.get('startup_authorized') is True or sql("SELECT count(*) FROM pg_tables WHERE schemaname='public'") == '0':
            if fresh.get('startup_authorized') is not True:
                write_json('paperless-fresh.json', {'application_version': APP_VERSION, 'startup_authorized': True})
            options = agent.read_envfile(str(STATE / 'paperless-ngx.env'))
            changed = migrate_options(options, legacy=False)
            if changed != options:
                agent.write_envfile(str(STATE / 'paperless-ngx.env'), changed)
                (STATE / 'paperless-ngx.env').chmod(0o600)
            return 'fresh'
    if prepare:
        source = source_checkpoint()
        if source.get('application_version') == '2.20.15':
            validate_v3_source()
        return 'source'
    raise RuntimeError('Upgrade blocked: install stable module 1.4.0 first; a prepared 2.20.15 checkpoint is required before v3 starts')


def archive_table(table, path):
    if path.exists() or not sql("SELECT COALESCE(to_regclass('" + table + "')::text, '')"):
        return
    db = agent.read_envfile(str(STATE / 'database.env'))
    temporary = path.with_suffix('.tmp')
    try:
        with temporary.open('wb') as output:
            result = subprocess.run(['podman', 'exec', 'paperless-pgsql', 'psql', '-XAt',
                '-U', db['POSTGRES_USER'], '-d', db['POSTGRES_DATABASE'], '-v', 'ON_ERROR_STOP=1',
                '-c', 'SELECT row_to_json(record)::text FROM ' + table + ' record ORDER BY id'],
                stdout=output, stderr=subprocess.PIPE, timeout=3600)
        if result.returncode:
            raise RuntimeError('Upgrade blocked: legacy task history could not be archived')
        temporary.chmod(0o600)
        temporary.replace(path)
    finally:
        if temporary.exists():
            temporary.unlink()


def prepare_configuration(directory, legacy=True):
    old_options = agent.read_envfile(str(STATE / 'paperless-ngx.env'))
    old_db = agent.read_envfile(str(STATE / 'paperless-db.env'))
    options = dict(old_options)
    for key in DB_OPTIONS:
        if key in old_db and key not in options:
            options[key] = old_db[key]
    changed = migrate_options(options, legacy=legacy)
    db = {key: value for key, value in old_db.items() if key not in DB_OPTIONS}
    db['PAPERLESS_DBENGINE'] = 'postgresql'
    try:
        agent.write_envfile(str(STATE / 'paperless-ngx.env'), changed)
        agent.write_envfile(str(STATE / 'paperless-db.env'), db)
        for name in ['paperless-ngx.env', 'paperless-db.env']:
            (STATE / name).chmod(0o600)
    except Exception:
        for name in ['paperless-ngx.env', 'paperless-db.env']:
            atomic_copy(directory / name, STATE / name)
        raise


def recover_freeze():
    frozen = read_json('paperless-freeze.json')
    if frozen.get('target_application') != APP_VERSION:
        return
    try:
        paused = run('podman', 'inspect', '--format', '{{.State.Paused}}', 'paperless-server') == 'true'
    except RuntimeError:
        paused = False
    if paused:
        run('podman', 'unpause', 'paperless-server')
    write_json('paperless-freeze.json', {})



def recover_preparation():
    pending = read_json('paperless-v3-preparation.json')
    transition = read_json('paperless-transition.json')
    if not pending or transition.get('target_application') == APP_VERSION:
        return
    source = source_checkpoint()
    if source.get('migration_fingerprint') != pending.get('source_fingerprint'):
        raise RuntimeError('Upgrade blocked: interrupted preparation does not match the source database')
    directory = STATE / 'upgrades/2.0.0'
    if file_hash(directory / 'paperless.pg_dump') != pending.get('backup_sha256'):
        raise RuntimeError('Upgrade blocked: interrupted preparation backup is invalid')
    for name in ['paperless-ngx.env', 'paperless-db.env']:
        atomic_copy(directory / name, STATE / name)
    (STATE / 'upgrades/paperless-v3-preparation.json').unlink()


def prepare_update():
    recover_preparation()
    recover_freeze()
    origin = preflight(prepare=True)
    if origin in ('checkpoint', 'transition', 'fresh'):
        return
    wait_database()
    directory = STATE / 'upgrades' / '2.0.0'
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    directory.chmod(0o700)
    paused = False
    try:
        try:
            running = run('podman', 'inspect', '--format', '{{.State.Running}}', 'paperless-server') == 'true'
        except RuntimeError:
            running = False
        already_paused = running and run('podman', 'inspect', '--format', '{{.State.Paused}}', 'paperless-server') == 'true'
        if running and not already_paused:
            write_json('paperless-freeze.json', {'target_application': APP_VERSION})
            run('podman', 'pause', 'paperless-server')
            paused = True
        run('module-dump-state', timeout=3600)
        dump = STATE / 'paperless.pg_dump'
        if not dump.is_file() or dump.stat().st_size == 0:
            raise RuntimeError('Upgrade blocked: the pre-migration database dump is empty')
        backup = directory / 'paperless.pg_dump'
        if not backup.exists():
            atomic_copy(dump, backup)
        # The earlier 1.4.0 archive retains exact pre-2.17 timestamps. Also
        # retain the pre-v3 calendar dates with this database checkpoint.
        dates = directory / 'pre-v3-document-created-dates.jsonl'
        if not dates.exists():
            data = sql("SELECT json_build_object('id', id, 'created', created)::text FROM documents_document ORDER BY id")
            temporary = dates.with_suffix('.tmp')
            temporary.write_text(data + ('\n' if data else ''))
            temporary.chmod(0o600)
            temporary.replace(dates)
        for name in ['environment', 'database.env', 'paperless-db.env',
                     'secret_key.env', 'paperless-ngx.env']:
            source = STATE / name
            target = directory / name
            if source.is_file() and not target.exists():
                atomic_copy(source, target)
        for table in ['documents_paperlesstask', 'django_celery_results_taskresult']:
            archive_table(table, directory / ('task-history-' + table + '.jsonl'))
        checkpoint = source_checkpoint()
        write_json('paperless-v3-preparation.json', {
            'source_fingerprint': checkpoint['migration_fingerprint'],
            'backup_sha256': file_hash(backup),
        })
        try:
            prepare_configuration(directory, legacy=checkpoint['application_version'] == '2.20.15')
            write_json('paperless-transition.json', {
                'target_application': APP_VERSION,
                'source_image': checkpoint.get('module_image', os.environ.get('PREV_IMAGE_URL', '')),
                'source_checkpoint': checkpoint,
                'target_configuration_fingerprint': configuration_fingerprint(),
                'backup_complete': True,
                'backup_directory': 'upgrades/2.0.0',
                'backup_sha256': file_hash(backup),
            })
        except Exception:
            for name in ['paperless-ngx.env', 'paperless-db.env']:
                atomic_copy(directory / name, STATE / name)
            raise

    finally:
        if paused:
            run('podman', 'unpause', 'paperless-server')
            write_json('paperless-freeze.json', {})


def mark_ready():
    preflight()
    options = agent.read_envfile(str(STATE / 'paperless-ngx.env'))
    host = urlsplit(options['PAPERLESS_URL']).hostname
    port = int(os.environ['TCP_PORT'])
    deadline = time.monotonic() + int(os.environ.get('PAPERLESS_UPGRADE_HEALTH_TIMEOUT', '1800'))
    while True:
        try:
            actual = run('podman', 'exec', 'paperless-server', 'python3', '-c',
                         'from paperless.version import __full_version_str__; print(__full_version_str__)')
            if actual != APP_VERSION:
                raise RuntimeError('The running application does not match the checkpoint version')
            connection = http.client.HTTPConnection('127.0.0.1', port, timeout=10)
            connection.request('GET', '/', headers={'Host': host})
            response = connection.getresponse()
            response.read()
            connection.close()
            if response.status in (200, 301, 302):
                break
        except (RuntimeError, OSError, http.client.HTTPException, subprocess.TimeoutExpired):
            pass
        if time.monotonic() >= deadline:
            raise RuntimeError('Application health did not pass; the upgrade checkpoint was not recorded')
        time.sleep(3)
    write_json('paperless-checkpoint.json', {
        'module_stage': MODULE_STAGE, 'application_version': APP_VERSION,
        'healthy': True, 'module_image': os.environ.get('IMAGE_URL', ''),
        'module_uuid': os.environ.get('MODULE_UUID', ''),
        'migration_fingerprint': migration_fingerprint(),
    })
    print(f'Paperless {APP_VERSION}: healthy module {MODULE_STAGE} checkpoint recorded')


def main():
    os.umask(0o077)
    operation = sys.argv[1]
    with (STATE / '.paperless-upgrade.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if operation == 'init':
            if not (STATE / 'upgrades/paperless-fresh.json').exists():
                write_json('paperless-fresh.json', {'application_version': APP_VERSION})
        elif operation in ('review', 'acknowledge'):
            source_checkpoint()
            options = options_for_review()
            queries = saved_queries()
            fingerprint = review_fingerprint(options, queries)
            required = review_requirements(options, queries)
            if operation == 'acknowledge':
                if len(sys.argv) < 3 or sys.argv[2] != fingerprint or not set(required) <= set(sys.argv[3:]):
                    raise RuntimeError('Review acknowledgement does not match the current configuration and required categories')
                write_json('paperless-v3-review.json', {'fingerprint': fingerprint, 'acknowledged': sorted(set(sys.argv[3:]))})
            print(json.dumps({'fingerprint': fingerprint, 'required_categories': required, 'acknowledged': operation == 'acknowledge'}))
        elif operation == 'check':
            preflight()
        elif operation == 'prepare':
            prepare_update()
        elif operation == 'ready':
            mark_ready()
        else:
            raise ValueError(operation)


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print(str(error), file=sys.stderr)
        sys.exit(2)
