#!/usr/bin/env python3
"""Map NS8 mail transport settings at every application startup."""
import os
import sys
import agent

os.umask(0o077)
settings = agent.get_smarthost_settings(agent.redis_connect(use_replica=True))
# Paperless/Django does not expose a certificate-verification toggle. Keep TLS
# verification enabled; do not mistake tls_verify for the transport selection.
if settings['enabled'] and not settings['tls_verify']:
    print('Paperless verifies SMTP TLS certificates; install a trusted certificate on the relay.', file=sys.stderr)
transport = settings['encrypt_smtp']
values = {
    'PAPERLESS_EMAIL_HOST': settings['host'] if settings['enabled'] else 'localhost',
    'PAPERLESS_EMAIL_PORT': settings['port'],
    'PAPERLESS_EMAIL_HOST_USER': settings['username'] if settings['enabled'] else '',
    'PAPERLESS_EMAIL_HOST_PASSWORD': settings['password'] if settings['enabled'] else '',
    'PAPERLESS_EMAIL_FROM': settings['username'] if settings['enabled'] else '',
    'PAPERLESS_EMAIL_USE_TLS': str(settings['enabled'] and transport == 'starttls').lower(),
    'PAPERLESS_EMAIL_USE_SSL': str(settings['enabled'] and transport == 'tls').lower(),
}
temporary = 'smarthost.env.tmp'
agent.write_envfile(temporary, values)
os.chmod(temporary, 0o600)
os.replace(temporary, 'smarthost.env')
